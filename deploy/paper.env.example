# paper credentials template: copy to deploy/paper.env and fill in.
# Paper/sandbox needs none of these; the file exists so the shape is ready
# for real channels. NEVER commit a filled paper.env (see tools/secret_scan.sh).
STS_PAPER_CUST_ID=
STS_PAPER_FUND_ACCOUNT_ID=
STS_PAPER_PASSWORD=
# PostgreSQL projection DSN (ADR-038): only the DSN for the compose
# postgres service goes here (password stays in POSTGRES_PASSWORD_FILE /
# server-side secrets, this file only assembles the client string).
# STS_PG_CONNINFO=host=postgres dbname=sts user=sts password=CHANGEME
