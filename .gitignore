# STS unified runtime layout (./bin): built binaries, logs and databases are
# local-only; only the yaml configs under ./bin/cfg are tracked (plus empty
# dir markers so the layout is visible after a fresh clone). NOTE: the
# directory itself must be re-included first -- a parent excluded by [Bb]in/
# above cannot have children re-included otherwise.
!/bin/
/bin/*
!/bin/cfg/
!/bin/log/
!/bin/db/
/bin/cfg/*
/bin/log/*
/bin/db/*
!/bin/cfg/*.yaml
!/bin/cfg/*.csv
!/bin/log/.gitkeep
!/bin/db/.gitkeep
# Local runtime backups (sts.sh backup / recover-drill output).
/backup/

# Local-only translated copy of AGENTS.md (not tracked).
/AGENTS-zh.md

# In-repo broker SDKs (ADR-040): pinned vendor binaries tracked
# deliberately (private repo only; see vendor/README.md guardrails).
# DEMO SOURCES, *.lic FILES AND CREDENTIALS MUST NEVER BE ADDED HERE.
!/vendor/ama/lib/Lnx64/libama.so
!/vendor/ama/lib/Lnx64/libfmdutil.so
!/vendor/ama/lib/Lnx64/libllmi.so
!/vendor/ama/lib/Lnx64/librmm.so
!/vendor/ama/lib/Lnx64/librum.so
!/vendor/ama/lib/Lnx64/libz.so.1
!/vendor/quantapi/lib/libatpquantapi.so
# Local-only vendor license (SDK stats it next to the .so; never commit).
/vendor/quantapi/lib/atp_quant_api.lic
